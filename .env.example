# ---- Core ----
ENV=dev                                   # dev | test | prod
DATABASE_URL=postgresql+asyncpg://vitalis:vitalis_dev@localhost:5432/vitalis
TEST_DATABASE_URL=postgresql+asyncpg://vitalis:vitalis_dev@localhost:5432/vitalis_test
JWT_SECRET=change-me-to-64-random-chars    # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                       # true behind HTTPS
PUBLIC_BASE_URL=http://localhost:3000
RATE_LIMIT_ENABLED=true

# ---- Disease model service ----
MODEL_URL=http://localhost:8100
MODEL_TIMEOUT_MS=800

# ---- Matching / referrals ----
CITY_SPEED_KMH=25
OVERDUE_GRACE_MINUTES=30
OVERDUE_CHECK_SECONDS=60

# ---- LLM (doctor summaries only, Phase 7). Synthetic data only. ----
ALLOW_EXTERNAL_LLM=false
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Notifications ----
SMS_PROVIDER=console                      # console (logs only) | termii | bulksmsnigeria
SMS_SENDER_ID=VITALIS                     # 3-11 characters; register it with the provider
TERMII_API_KEY=                           # termii.com dashboard (free credit on sign-up)
TERMII_BASE_URL=https://v3.api.termii.com # use the base URL shown on your Termii dashboard
TERMII_CHANNEL=generic                    # dnd once Termii enables transactional routing
BULKSMSNIGERIA_API_TOKEN=                 # bulksmsnigeria.com (N50 free credit on sign-up)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                            # empty = PUBLIC_BASE_URL; keys empty = generated once into backend/var/vapid.json

# ---- Demo seed ----
DEMO_PASSWORD=                            # empty = random; written to backend/var/DEMO_LOGINS.md and .pdf
DEMO_LOGINS=true                          # one-tap demo sign-in on /auth/login and /card; false before any real pilot

# ---- Deployment (deploy/deploy.sh + docker compose) ----
DOMAIN=vitalis.olamide.cloud
POSTGRES_PASSWORD=change-me
