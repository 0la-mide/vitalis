# ---- Core ----
ENV=dev                                   # dev | test | prod
DATABASE_URL=postgresql+asyncpg://vitalis:vitalis_dev@localhost:5432/vitalis
TEST_DATABASE_URL=postgresql+asyncpg://vitalis:vitalis_dev@localhost:5432/vitalis_test
JWT_SECRET=change-me-to-64-random-chars    # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                       # true behind HTTPS
PUBLIC_BASE_URL=http://localhost:3000
RATE_LIMIT_ENABLED=true

# ---- Disease model service ----
MODEL_URL=http://localhost:8100
MODEL_TIMEOUT_MS=800

# ---- Matching / referrals ----
CITY_SPEED_KMH=25
OVERDUE_GRACE_MINUTES=30
OVERDUE_CHECK_SECONDS=60

# ---- LLM (doctor summaries only, Phase 7). Synthetic data only. ----
ALLOW_EXTERNAL_LLM=false
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Notifications ----
SMS_PROVIDER=console                      # console | africastalking | termii
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# ---- Demo seed ----
DEMO_PASSWORD=                            # empty = random; written to backend/var/DEMO_LOGINS.md

# ---- Deployment (deploy/deploy.sh + docker compose) ----
DOMAIN=vitalis.olamide.cloud
POSTGRES_PASSWORD=change-me
